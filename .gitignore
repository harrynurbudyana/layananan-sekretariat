# ==========================================
# FIT E-Office - .gitignore
# ==========================================

# 1. Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 2. Next.js Build & Production Output
/.next/
/out/
/build
/dist
/coverage
*.tsbuildinfo
next-env.d.ts

# 3. Environment Variables & Secrets
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# 4. SQLite Database & Local Storage (dev.db disertakan agar data riil ikut terdeploy)
*.db-journal
*.sqlite-journal
prisma/*.db-journal
prisma/dev.db-journal
!prisma/dev.db

# 5. Logs & Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# 6. Temporary Files & Local Exports
*.csv
*.pdf
/tmp
/temp

# 7. IDE, Editors & Agent Tools
.vscode/
.idea/
.windsurf/
.claude/
.agents/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*.pem

# 8. OS System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# 9. Vercel & Cloud Deployment
.vercel
