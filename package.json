{
  "name": "fit-eoffice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5000",
    "build": "prisma generate && prisma generate --schema=prisma/schema-rooms.prisma && next build",
    "start": "next start -p 5000",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:push": "prisma db push",
    "db:rooms:push": "prisma db push --schema=prisma/schema-rooms.prisma",
    "db:rooms:generate": "prisma generate --schema=prisma/schema-rooms.prisma",
    "db:rooms:seed": "npx tsx scripts/seed-rooms.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.40.0",
    "next": "16.3.4",
    "pdf-parse": "^2.4.5",
    "pm2": "^7.0.4",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
